PORT=5000
NODE_ENV=development

# MongoDB (Atlas preferred)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ciphersqlstudio?retryWrites=true&w=majority

# PostgreSQL (Sandbox DB)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ciphersqlstudio_sandbox
PG_USER=postgres
PG_PASSWORD=yourpassword

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# LLM API - Google Gemini (required for hints)
GEMINI_API_KEY=your-gemini-api-key-here

# CORS
CLIENT_URL=http://localhost:3000
